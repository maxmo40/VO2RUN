# Exemple de configuration SMTP (optionnel)
# Copiez ce fichier en `.env` et remplissez les valeurs si vous voulez
# que le serveur envoie un email de notification lorsqu'une réservation est reçue.

PORT=3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=utilisateur@example.com
SMTP_PASS=motdepasse
SMTP_FROM=LabPerformance <no-reply@example.com>
NOTIFY_TO=you@domain.com
